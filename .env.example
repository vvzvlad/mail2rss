# mail2rss — full list of env vars (SPEC.md §10.2).
# Copy to .env and fill in:  make env      (.env is gitignored; this file is committed)
# PLACEHOLDERS ONLY — never commit a real token or secret here.

# --- Required. No defaults: the service refuses to start if any is missing. ------

# Fastmail JMAP API token.
# Fastmail → Settings → Privacy & Security → Connected apps & API tokens →
# Manage API tokens → New API token. Type: JMAP. Scopes: "Read-only access" + "Email".
# The token is shown ONCE. API tokens are NOT available on the Basic plan.
FASTMAIL_API_TOKEN=your_token_here

# 128-bit base32 secret: 26 lowercase chars [a-z2-7], no padding. Generate it with
#   make gen-secret
# EVERY feed and media URL is derived from it, and its format is checked at startup,
# so a hand-typed value will be rejected.
# BACK IT UP: losing it changes every feed URL and you must re-import the OPML into Miniflux.
MAIL2RSS_SECRET=generate_with_make_gen_secret

# Public https URL of THIS service — it is baked into the links inside the feed.
# No default on purpose: a localhost default would silently ship broken links to the reader.
BASE_URL=https://rss.example.com

# --- Optional. The defaults live in src/settings.py; uncomment only to override. --

# Fastmail JMAP session endpoint (public third-party API, so a default is allowed).
# JMAP_SESSION_URL=https://api.fastmail.com/jmap/session

# Seconds a rendered feed is served from cache before JMAP is queried again.
# CACHE_TTL=600

# Server-side ceiling on ?limit=, forced regardless of what the URL signature says.
# MAX_LIMIT=100

# Seconds the mailbox tree is cached; a new folder shows up without a restart.
# MAILBOX_TREE_TTL=3600

# Per-folder URL revocation counters, e.g. "M9f3ac21b:2,M77bb01c:5" (SPEC.md §4.7).
# Bumping a counter changes the URL of that one folder. Empty = nothing revoked.
# MAIL2RSS_EPOCH=

# SQLite cache file. Keep it under data/ — that is the only writable, volume-mounted dir.
# CACHE_DB_PATH=data/cache.db

LOG_LEVEL=INFO
